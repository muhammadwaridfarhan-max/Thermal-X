<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thermal-X"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnMagisk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Magisk Module"
        android:backgroundTint="#3F51B5" />

    <Button
        android:id="@+id/btnKernelsu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KernelSU Module"
        android:layout_marginTop="12dp"
        android:backgroundTint="#4CAF50" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle Thermal Throttling"
        android:textSize="18sp"
        android:layout_marginTop="32dp" />

    <MaterialSwitch
        android:id="@+id/switchThermal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thermal Throttling (ON/OFF)"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle Fast Charging"
        android:textSize="18sp"
        android:layout_marginTop="24dp" />

    <MaterialSwitch
        android:id="@+id/switchFastCharge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fast Charging (ON/OFF)"
        android:layout_marginTop="8dp" />

</LinearLayout>
